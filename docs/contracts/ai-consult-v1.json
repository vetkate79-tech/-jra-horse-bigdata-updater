{
  "contract_version": "ai-consult-v1",
  "request": {
    "question": "string",
    "context": {
      "race_id": "string|null",
      "race_date": "YYYY-MM-DD|null",
      "track": "string|null",
      "race_no": "integer|null",
      "horse_ids": ["string"],

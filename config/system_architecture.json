{
  "schema_version": 1,
  "objective": "One clean production flow with explicitly independent subsystems",
  "production_flow": [
    "JRA_OFFICIAL_DATA_INGEST",
    "HORSE_MASTER_UPDATE",
    "RACE_WEEK_EXPANSION",
    "PURE_PREDICTION",
    "PREDICTION_SEAL",
    "MARKET_EV_GATE",
    "FINAL_TICKETS",
    "RESULT_INGEST",
    "SCORING",
    "PDCA",
    "HORSE_MASTER_RESULT_MERGE"
  ],
  "active_workflows": {
    "post-jra-meeting-update.yml": "RESULT_INGEST -> SCORING -> PDCA -> HORSE_MASTER_RESULT_MERGE",
    "register-upcoming-new-horses.yml": "RACE_WEEK_EXPANSION",
    "horse-master-maintenance.yml": "HORSE_MASTER_UPDATE",
    "race-week-prediction-seal.yml": "PURE_PREDICTION -> PREDICTION_SEAL",
    "jra-market-timing.yml": "MARKET_EV_GATE_INDEPENDENT",
    "validate-jra-model.yml": "MODEL_VALIDATION_INDEPENDENT",
    "audit-oral-v6-certification.yml": "PRODUCTION_MODEL_CERTIFICATION_INDEPENDENT",
    "build-word-dictionary.yml": "SITE_DICTIONARY_INDEPENDENT",
    "deploy-management-erp.yml": "SITE_DEPLOY_INDEPENDENT",
    "repair-horse-master-integrity.yml": "EMERGENCY_REPAIR_INDEPENDENT",
    "system-architecture-audit.yml": "GOVERNANCE_AUDIT"
  },
  "independent_subsystems": {
    "market": {
      "workflow": "jra-market-timing.yml",
      "rule": "Odds/popularity may affect only value and purchase judgement after prediction seal; never pure ability ranking."
    },
    "validation": {
      "workflow": "validate-jra-model.yml",
      "rule": "Validation uses leakage-safe ledgers and cannot write into live prediction outputs."
    },
    "model_certification": {
      "workflow": "audit-oral-v6-certification.yml",
      "rule": "Golden-case parity and leakage checks are independent from race-day operation."
    },
    "site_dictionary": {
      "workflow": "build-word-dictionary.yml",
      "rule": "Terminology generation never changes horse ranking or betting logic."
    },
    "emergency_repair": {
      "workflow": "repair-horse-master-integrity.yml",
      "rule": "Manual-only repair path; not part of normal production sequence."
    }
  },
  "single_writer_groups": {
    "horse_master": "horse-data-writes",
    "live_prediction": "live-prediction-seal",
    "market": "market-status-writes",
    "dictionary": "site-dictionary-writes",
    "pages": "pages"
  },
  "active_workflow_script_policy": {
    "audit-oral-v6-certification.yml": ["audit_oral_golden_v6.py", "audit_oral_v6_robustness.py"],
    "build-word-dictionary.yml": ["build_site_term_candidates.py", "build_word_dictionary_pages.py", "import_jra_official_glossary.py", "inject_global_word_links.py"],
    "deploy-management-erp.yml": ["build_august_validation_archive.py"],
    "horse-master-maintenance.yml": ["build_horse_base_catalog.py", "check_horse_master_completion.py", "collect_active_elite_horses.py", "discover_registered_horse_ids.py", "enrich_all_catalog_profiles.py", "enrich_new_horse_entries.py", "expand_horse_categories.py", "merge_active_elite_into_catalog.py"],
    "jra-market-timing.yml": ["market_timing_gate.py"],
    "post-jra-meeting-update.yml": ["build_horse_base_catalog.py", "build_live_pdca.py", "check_horse_master_completion.py", "collect_jra_recent_completed.py", "expand_horse_categories.py", "expire_weekly_runner_details.py", "merge_active_elite_into_catalog.py", "merge_latest_results_into_catalog.py", "score_live_sealed_predictions.py", "update_recent_runner_elite.py"],
    "race-week-prediction-seal.yml": ["build_live_sealed_predictions.py", "oral_operational_layer.py"],
    "register-upcoming-new-horses.yml": ["build_horse_base_catalog.py", "build_race_week_pre_race_features.py", "check_horse_master_completion.py", "collect_upcoming_new_horses.py", "collect_upcoming_runner_details.py", "enrich_new_horse_entries.py"],
    "repair-horse-master-integrity.yml": ["check_horse_master_completion.py", "merge_active_elite_into_catalog.py", "reconcile_elite_from_verified_master.py"],
    "system-architecture-audit.yml": ["audit_system_architecture.py"],
    "validate-jra-model.yml": ["audit_validation_prerequisites.py", "build_validation_dataset.py", "evaluate_backtest.py", "manage_experiment_registry.py"]
  },
  "retired_workflow_policy": "Historical experiments, one-off diagnostics, backfills and V2-V14 replay calibration workflows live in .github/workflow-archive and cannot trigger automatically.",
  "no_mix_rules": [
    "PURE_PREDICTION must not read odds, popularity, payout or target result fields.",
    "MARKET_EV_GATE must not rewrite pure prediction rankings.",
    "RESULT_INGEST starts only after races complete and must not modify sealed historical predictions.",
    "MODEL_VALIDATION must remain separate from production writes.",
    "SITE_DICTIONARY and SITE_DEPLOY must remain separate from racing model state."
  ]
}
